# Database connection and application signing secret (never exposed to the browser).
DATABASE_URL=
SECRET_KEY=

# Public browser map key. Leave blank to show the map-unavailable message.
GEOAPIFY_API_KEY=
# Tile URL template without an apiKey parameter.
GEOAPIFY_TILE_URL=https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}{r}.png

# Public APIs called directly by the browser (no keys required).
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_API_URL=https://api.open-meteo.com/v1/forecast
WIKIMEDIA_API_URL=https://en.wikipedia.org/w/api.php

# Nearby places API called by Flask, not the browser.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
